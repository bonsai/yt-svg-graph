  },
  "scenes": [
    {
      "scene_id": "scene_00",
      "index": 0,
      "start": 0.3,
      "end": 11.028,
      "display_start": 0.0,
      "display_end": 11.428,
      "display_duration": 11.428,
      "text": "スタバやマックより、店が多い飲食チェーン。知っていますか？ その正体は、中国発のMIXUEです。",
      "visual": "stores"
    },
    {
      "scene_id": "scene_01",
      "index": 1,
      "start": 11.428,
      "end": 22.132,
      "display_start": 11.028,
      "display_end": 22.532,
      "display_duration": 11.504,
      "text": "記事掲載価格では、台湾茶が100円、レモンティーが130円。いったい、どうしてこの価格が可能なのでしょうか。",
      "visual": "price"
    },
    {
      "scene_id": "scene_02",
      "index": 2,
      "start": 22.532,
      "end": 41.756,
      "display_start": 22.132,
      "display_end": 42.156,
      "display_duration": 20.024,
      "text": "物語の始まりは1997年、中国・河南省。創業者の張紅超が始めた小さなかき氷屋台が、MIXUEの原点とされています。最初から世界を目指す巨大企業だったわけではありません。",
      "visual": "origin"
    },
    {
      "scene_id": "scene_03",
      "index": 3,
      "start": 42.156,
      "end": 60.708,
      "display_start": 41.756,
      "display_end": 61.108,
      "display_duration": 19.352,
      "text": "かき氷からソフトクリームへ。そしてお茶やレモンティーへ。商品を広げながら、誰もが気軽に楽しめる価格を追求しました。特別な日の一杯ではなく、日常に寄り添う一杯を目指したのです。",
      "visual": "products"
    },
    {
      "scene_id": "scene_04",
      "index": 4,
      "start": 61.108,
      "end": 78.916,
      "display_start": 60.708,
      "display_end": 79.316,
      "display_duration": 18.608,
      "text": "強みは安さだけではありません。原材料の調達から加工、物流までを効率化し、フランチャイズ方式で店舗を広げる。商品を安くするだけでなく、安く届け続ける仕組みをつくったのです。",
      "visual": "supply"
    },
    {
      "scene_id": "scene_05",
      "index": 5,
      "start": 79.316,
      "end": 94.94,
      "display_start": 78.916,
      "display_end": 95.34,
      "display_duration": 16.424,
      "text": "さらに、王冠をかぶった雪だるまのようなキャラクター、雪王と、耳に残るテーマソングがSNSで話題に。商品だけでなく、ブランド自体が共有したくなるコンテンツになりました。",
      "visual": "mascot"
    },
    {
      "scene_id": "scene_06",
      "index": 6,
      "start": 95.34,
      "end": 115.86,
      "display_start": 94.94,
      "display_end": 116.26,
      "display_duration": 21.32,
      "text": "MIXUEは世界規模へ成長し、日本にも進出しています。ただ、日本ではまだ店舗数は限られています。コンビニや自動販売機が身近な日本で、価格だけでなく、味や体験でも選ばれるのか。これからが注目です。",
      "visual": "japan"
    },
    {
      "scene_id": "scene_07",
      "index": 7,
      "start": 116.26,
      "end": 138.436,
      "display_start": 115.86,
      "display_end": 139.036,
      "display_duration": 23.176,
      "text": "一軒の屋台から始まった商いが、世界へ。そして日本の街へ。これから店舗が増え、雪王の看板を見かける日常が来るかもしれません。大きな企業も、始まりは小さな一歩。MIXUEの次の成長ストーリーを見届けましょう。",
      "visual": "ending"
    }
  ],
